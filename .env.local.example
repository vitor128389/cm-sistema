NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave secreta — NUNCA leva o prefixo NEXT_PUBLIC_, NUNCA aparece no navegador.
# Pega em Project Settings -> API Keys -> "service_role" (ou "secret", nas contas novas).
# Só é usada dentro de app/api/** (código que roda no servidor).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
